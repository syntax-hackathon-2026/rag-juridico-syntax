\par }\pard \ltrpar\qj \li-11\ri0\widctlpar\tx-720\wrapdefault\hyphpar0\nooverflow\faroman\rin0\lin-11\itap0 {\rtlch\fcs1 \af0 \ltrch\fcs0 \b\fs28\expnd0\expndtw-3\insrsid9251551 7.3.2 }{\rtlch\fcs1 \af0 \ltrch\fcs0 \fs28\expnd0\expndtw-3\insrsid9251551 
