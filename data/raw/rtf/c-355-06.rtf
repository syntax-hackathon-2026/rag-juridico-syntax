\par }\pard \ltrpar\qj \li567\ri0\widctlpar\wrapdefault\nooverflow\faroman\rin0\lin567\itap0 {\rtlch\fcs1 \af0 \ltrch\fcs0 \b\fs28\insrsid9251551 BLOQUE DE CONSTITUCIONALIDAD EN SENTIDO LATO}{\rtlch\fcs1 \af0 \ltrch\fcs0 \fs28\insrsid9251551 -Integraci\'f3n/}{
\rtlch\fcs1 \af0 \ltrch\fcs0 \b\fs28\insrsid9251551 BLOQUE DE CONSTITUCIONALIDAD STRICTO SENSU}{\rtlch\fcs1 \af0 \ltrch\fcs0 \fs28\insrsid9251551 -Integraci\'f3n (Salvamento de voto)
\par 
\par }{\rtlch\fcs1 \af0 \ltrch\fcs0 \b\fs28\insrsid9251551 CONVENIO INTERNACIONAL DE TRABAJO RATIFICADO POR COLOMBIA-}{\rtlch\fcs1 \af0 \ltrch\fcs0 \fs28\insrsid9251551 Integraci\'f3n a la legislaci\'f3n interna (Salvamento de voto)
\par }{\rtlch\fcs1 \af0 \ltrch\fcs0 \i\fs28\insrsid9251551 
